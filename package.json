{
  "name": "trilingual-records-viewer",
  "version": "1.0.0",
  "description": "Simple web viewer for local trilingual HTML records",
  "main": "server.mjs",
  "scripts": {
    "start": "NODE_ENV=production node server.mjs",
    "dev:react": "NODE_ENV=development node server.mjs",
    "build:react": "react-router build && node scripts/build/markReactServerEsm.js",
    "typecheck:react": "react-router typegen && tsc --noEmit",
    "test:architecture": "npm run build:react && node scripts/tests/architectureCompletion.js && node scripts/tests/reactRootOwnership.js",
    "test:acceptance": "bash ./scripts/tests/architectureAcceptance.sh",
    "test": "node --test tests/unit/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "smoke": "bash ./scripts/tests/smoke.sh",
    "e2e:server": "bash ./scripts/tests/startE2EServer.sh",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test tests/e2e/app-shell.spec.js",
    "test:e2e:pages": "playwright test tests/e2e/pages.spec.js",
    "test:textbooks:acceptance": "bash ./scripts/tests/textbookAcceptance.sh",
    "cards:migrate-style": "node scripts/migrations/updateLegacyCardStyle.js --apply",
    "cards:import-kindergarden": "node scripts/import/importKindergarden.js --apply",
    "cards:reassign-kindergarden-date": "node scripts/migrations/reassignFolderDate.js --source=kindergarden --target=20260713 --date=2026-07-13",
    "cards:annotations:migration-plan": "node scripts/maintenance/buildCardAnnotationMigrationPlan.js",
    "cards:annotations:migrate": "node scripts/maintenance/applyCardAnnotationMigrationPlan.js",
    "cards:annotations:r1": "node scripts/maintenance/cardAnnotationR1Observation.js",
    "kg:p0": "node scripts/poc/kgP0DryRun.js",
    "kg:p1:dry-run": "node scripts/maintenance/kgP1BackfillDryRun.js",
    "kg:r0:apply": "node scripts/maintenance/applyKnowledgeBackfill.js --apply",
    "kg:r1:canary": "node scripts/maintenance/kgR1PlanningCanary.js",
    "kg:r2:sync": "node scripts/maintenance/kgR2IncrementalSync.js"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@react-router/express": "8.3.0",
    "@react-router/node": "8.3.0",
    "@tanstack/react-query": "^5.101.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "^12.6.2",
    "d3": "^7.9.0",
    "dompurify": "^3.4.12",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "isbot": "^5",
    "jsdom": "^27.4.0",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "lucide-react": "^1.24.0",
    "marked": "^9.1.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.3.0",
    "ts-fsrs": "5.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@react-router/dev": "8.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "10.8.0",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
